// Migrations-Workflow mit Custom-SQL (z. B. Exclusion-Constraints, Extensions):
//   1. Schema ändern, dann `pnpm prisma migrate dev --create-only --name <name>`
//   2. Erzeugtes prisma/migrations/<ts>_<name>/migration.sql um Custom-SQL ergänzen
//   3. `pnpm prisma migrate dev` wendet die Migration an
// Prisma diff-t nur das Schema; reines Custom-SQL (btree_gist, EXCLUDE, Trigger)
// lebt ausschließlich in den migration.sql-Dateien. Nie `migrate reset` ohne Not.
//
// Prisma 7: Die Verbindungs-URL steht in prisma.config.ts (CLI/Migrate) bzw.
// im Driver-Adapter in src/db/client.ts (Laufzeit), nicht mehr hier.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth-Grundlage (Ticket 0.4). Vollständiges Domain-Schema folgt mit Ticket 1.1
// (docs/02_DATENMODELL.md); die Modelle hier sind das dort definierte Subset.

enum MembershipRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPERADMIN
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  phone         String?
  passwordHash  String?
  // Lastenheft nennt das Feld emailVerifiedAt; hier Auth.js-Konvention (Adapter).
  emailVerified DateTime?
  image         String?
  sepaBlocked   Boolean   @default(false)
  anonymizedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships Membership[]
  accounts    Account[]
  sessions    Session[]
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organisationId String
  role           MembershipRole @default(CUSTOMER)
  venueIds       String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

// --- Auth.js-Adapter-Tabellen (https://authjs.dev/getting-started/adapters/prisma) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
