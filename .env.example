# Lokale Entwicklung: Werte kopieren nach .env und anpassen.
# Secrets niemals committen (CLAUDE.md / NF11).

# --- Datenbank (docker-compose.yml, Service "db") ---
POSTGRES_USER=dtd
POSTGRES_PASSWORD=dtd_local_dev
POSTGRES_DB=dtd_booking
# 5433, weil auf Janicks Rechner ein natives PostgreSQL 16 Port 5432 belegt
POSTGRES_PORT=5433
DATABASE_URL=postgresql://dtd:dtd_local_dev@localhost:5433/dtd_booking

# Integrationstests (pnpm test:int) laufen gegen die Test-DB:
DATABASE_URL_TEST=postgresql://dtd:dtd_local_dev@localhost:5433/dtd_booking_test

# --- Auth (Ticket 0.4) ---
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Mailversand (Ticket 1.9): ohne RESEND_API_KEY wird lokal nur geloggt.
# Bis zur Domain-Verifizierung als Absender onboarding@resend.dev verwenden.
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_BRAND_NAME=Picco Beach Buchung

# Mandant für Registrierung/öffentliches Frontend (Multi-Venue-UI ist S3)
DEFAULT_ORG_SLUG=dtd

# Rate-Limits (NF10); ungesetzt gelten die Prod-Defaults 5 (Login) / 3
# (Registrierung) pro Adresse und 15 Minuten. Für lokale E2E-Läufe hochsetzen.
# LOGIN_RATE_LIMIT=1000
# REGISTER_RATE_LIMIT=1000

# --- Stripe (Ticket 0.6) – Sandbox/Test-Keys, nie Live-Keys vor Go-Live ---
# Dashboard → Entwickler → API-Schlüssel
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# kommt von `pnpm stripe:listen` (Stripe CLI) bzw. dem Webhook-Endpunkt im Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Seed (pnpm seed) ---
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=mindestens-10-zeichen
# optional: Kunden-Testuser für E2E-Guard-Tests
SEED_CUSTOMER_EMAIL=kunde@example.org
SEED_CUSTOMER_PASSWORD=mindestens-10-zeichen
