# Lokale Entwicklung: Werte kopieren nach .env und anpassen.
# Secrets niemals committen (CLAUDE.md / NF11).

# --- Datenbank (docker-compose.yml, Service "db") ---
POSTGRES_USER=dtd
POSTGRES_PASSWORD=dtd_local_dev
POSTGRES_DB=dtd_booking
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dtd:dtd_local_dev@localhost:5432/dtd_booking

# Integrationstests (src/services/) laufen gegen die Test-DB:
# DATABASE_URL_TEST=postgresql://dtd:dtd_local_dev@localhost:5432/dtd_booking_test
